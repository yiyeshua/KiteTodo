<Page x:Class="KiteTodo.Views.Pages.MarkdownReaderPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
      Title="Markdown 阅读"
      Language="zh-CN"
      AllowDrop="True"
    PreviewKeyDown="OnPreviewKeyDown"
      DragOver="OnDragOver"
      Drop="OnDropFile">

    <Page.Resources>
        <Style x:Key="HelpCardStyle" TargetType="Border">
            <Setter Property="Margin" Value="0,8,0,0"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Background" Value="{DynamicResource CustomSubtleBg}"/>
        </Style>

        <Style x:Key="HelpTitleStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="HelpSnippetStyle" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Setter Property="FontFamily" Value="Cascadia Code,Consolas,Microsoft YaHei UI"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{DynamicResource CustomFg}"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
        </Style>
    </Page.Resources>

    <Grid Margin="24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Margin="0,0,0,10" Padding="12,8" CornerRadius="10"
                Background="{DynamicResource CustomCardBg}" BorderThickness="1"
                BorderBrush="{DynamicResource CustomSubtleBorder}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Markdown 阅读" FontSize="18" FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource CustomFg}"/>

                <TextBlock Grid.Column="2" x:Name="FileInfoText"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Text="还没有打开 Markdown 文件 · 支持 .md、.markdown、.txt"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource CustomFgSecondary}"/>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                    <ui:Button x:Name="ZoomOutButton" Content="A-" Appearance="Secondary" Click="OnZoomOut" Padding="10,6" FontSize="12" Margin="0,0,6,0"/>
                    <Border Padding="8,4" Margin="0,0,6,0" CornerRadius="8" Background="{DynamicResource CustomSubtleBg}" BorderBrush="{DynamicResource CustomSubtleBorder}" BorderThickness="1">
                        <TextBlock x:Name="ZoomText" Text="118%" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource CustomFgSecondary}"/>
                    </Border>
                    <ui:Button x:Name="ZoomInButton" Content="A+" Appearance="Secondary" Click="OnZoomIn" Padding="10,6" FontSize="12" Margin="0,0,8,0"/>
                    <ui:Button x:Name="ToggleOutlineButton" Content="隐藏目录" Appearance="Secondary" Click="OnToggleOutline" Visibility="Collapsed" Margin="0,0,8,0" Padding="12,6" FontSize="12"/>
                    <ui:Button x:Name="ToggleHelpButton" Content="显示语法" Appearance="Secondary" Click="OnToggleHelp" Visibility="Collapsed" Margin="0,0,8,0" Padding="12,6" FontSize="12"/>
                    <ui:Button x:Name="ToggleModeButton" Content="查看源码" Appearance="Secondary" Click="OnToggleMode" IsEnabled="False" Margin="0,0,8,0" Padding="12,6" FontSize="12"/>
                    <ui:Button Content="打开文件" Appearance="Primary" Click="OnOpenFile" Margin="0,0,8,0" Padding="14,6" FontSize="12"/>
                    <ui:Button x:Name="SaveButton" Content="保存" Appearance="Secondary" Click="OnSaveFile" IsEnabled="False" Margin="0,0,8,0" Padding="12,6" FontSize="12"/>
                    <ui:Button x:Name="ReloadButton" Content="重新加载" Appearance="Secondary" Click="OnReloadFile" IsEnabled="False" Padding="12,6" FontSize="12"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Border x:Name="EmptyStatePanel"
                    CornerRadius="14"
                    Background="{DynamicResource CustomCardBg}"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource CustomSubtleBorder}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="BookOpen24" FontSize="48" Opacity="0.25" HorizontalAlignment="Center"/>
                    <TextBlock Text="打开一个 Markdown 文件开始阅读"
                               Margin="0,12,0,0"
                               FontSize="16"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource CustomFg}"/>
                    <TextBlock Text="你也可以把文件直接拖到这个页面。"
                               Margin="0,6,0,0"
                               FontSize="12"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource CustomFgSecondary}"/>
                </StackPanel>
            </Border>

            <Border x:Name="PreviewHost"
                    Visibility="Collapsed"
                    CornerRadius="14"
                    ClipToBounds="True"
                    Background="White"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource CustomSubtleBorder}">
                <wv2:WebView2 x:Name="PreviewBrowser"/>
            </Border>

            <Border x:Name="SourceHost"
                    Visibility="Collapsed"
                    CornerRadius="14"
                    Background="{DynamicResource CustomCardBg}"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource CustomSubtleBorder}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="SourceEditorColumn" Width="2.75*"/>
                        <ColumnDefinition x:Name="SourceDividerColumn" Width="0"/>
                        <ColumnDefinition x:Name="SourceHelpColumn" Width="0"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="SourceTextBox"
                             Grid.Column="0"
                             AcceptsReturn="True"
                             AcceptsTab="True"
                             TextWrapping="NoWrap"
                             HorizontalScrollBarVisibility="Auto"
                             VerticalScrollBarVisibility="Auto"
                             Padding="18,16"
                             BorderThickness="0"
                             Background="Transparent"
                             Foreground="{DynamicResource CustomFg}"
                             FontFamily="Cascadia Code,Consolas,Microsoft YaHei UI"
                             FontSize="13"
                             TextChanged="OnSourceTextChanged"/>

                    <Border x:Name="SourceDivider"
                            Grid.Column="1"
                            Visibility="Collapsed"
                            Width="1"
                            Background="{DynamicResource CustomSubtleBorder}"/>

                    <ScrollViewer x:Name="SourceHelpPanel"
                                  Grid.Column="2"
                                  Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="12,10,12,12">
                            <TextBlock Text="Markdown 常用语法" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{DynamicResource CustomFg}"/>

                            <Border Style="{StaticResource HelpCardStyle}">
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock Text="标题" Style="{StaticResource HelpTitleStyle}"/>
                                        <ui:Button DockPanel.Dock="Right" Content="复制" Tag="# 一级标题&#10;## 二级标题&#10;### 三级标题" Click="OnCopyHelpSnippet" Padding="8,2" FontSize="11" Appearance="Secondary"/>
                                    </DockPanel>
                                    <TextBox Style="{StaticResource HelpSnippetStyle}" Text="# 一级标题&#10;## 二级标题&#10;### 三级标题"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource HelpCardStyle}">
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock Text="列表" Style="{StaticResource HelpTitleStyle}"/>
                                        <ui:Button DockPanel.Dock="Right" Content="复制" Tag="- 无序项&#10;- 第二项&#10;&#10;1. 有序项&#10;2. 第二项" Click="OnCopyHelpSnippet" Padding="8,2" FontSize="11" Appearance="Secondary"/>
                                    </DockPanel>
                                    <TextBox Style="{StaticResource HelpSnippetStyle}" Text="- 无序项&#10;- 第二项&#10;&#10;1. 有序项&#10;2. 第二项"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource HelpCardStyle}">
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock Text="任务列表" Style="{StaticResource HelpTitleStyle}"/>
                                        <ui:Button DockPanel.Dock="Right" Content="复制" Tag="- [ ] 待完成&#10;- [x] 已完成" Click="OnCopyHelpSnippet" Padding="8,2" FontSize="11" Appearance="Secondary"/>
                                    </DockPanel>
                                    <TextBox Style="{StaticResource HelpSnippetStyle}" Text="- [ ] 待完成&#10;- [x] 已完成"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource HelpCardStyle}">
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock Text="强调" Style="{StaticResource HelpTitleStyle}"/>
                                        <ui:Button DockPanel.Dock="Right" Content="复制" Tag="**加粗**&#10;*斜体*&#10;`行内代码`" Click="OnCopyHelpSnippet" Padding="8,2" FontSize="11" Appearance="Secondary"/>
                                    </DockPanel>
                                    <TextBox Style="{StaticResource HelpSnippetStyle}" Text="**加粗**&#10;*斜体*&#10;`行内代码`"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource HelpCardStyle}">
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock Text="链接和图片" Style="{StaticResource HelpTitleStyle}"/>
                                        <ui:Button DockPanel.Dock="Right" Content="复制" Tag="[链接文字](https://example.com)&#10;![图片说明](image.png)" Click="OnCopyHelpSnippet" Padding="8,2" FontSize="11" Appearance="Secondary"/>
                                    </DockPanel>
                                    <TextBox Style="{StaticResource HelpSnippetStyle}" Text="[链接文字](https://example.com)&#10;![图片说明](image.png)"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource HelpCardStyle}">
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock Text="引用和分隔线" Style="{StaticResource HelpTitleStyle}"/>
                                        <ui:Button DockPanel.Dock="Right" Content="复制" Tag="> 这是一段引用&#10;&#10;---" Click="OnCopyHelpSnippet" Padding="8,2" FontSize="11" Appearance="Secondary"/>
                                    </DockPanel>
                                    <TextBox Style="{StaticResource HelpSnippetStyle}" Text="> 这是一段引用&#10;&#10;---"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource HelpCardStyle}">
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock Text="代码块" Style="{StaticResource HelpTitleStyle}"/>
                                        <ui:Button DockPanel.Dock="Right" Content="复制" Tag="```csharp&#10;Console.WriteLine(&quot;Hello&quot;);&#10;```" Click="OnCopyHelpSnippet" Padding="8,2" FontSize="11" Appearance="Secondary"/>
                                    </DockPanel>
                                    <TextBox Style="{StaticResource HelpSnippetStyle}" Text="```csharp&#10;Console.WriteLine(&quot;Hello&quot;);&#10;```"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource HelpCardStyle}">
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock Text="表格" Style="{StaticResource HelpTitleStyle}"/>
                                        <ui:Button DockPanel.Dock="Right" Content="复制" Tag="| 名称 | 说明 |&#10;| --- | --- |&#10;| A | 内容 |" Click="OnCopyHelpSnippet" Padding="8,2" FontSize="11" Appearance="Secondary"/>
                                    </DockPanel>
                                    <TextBox Style="{StaticResource HelpSnippetStyle}" Text="| 名称 | 说明 |&#10;| --- | --- |&#10;| A | 内容 |"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>