<Page x:Class="KiteTodo.Views.Pages.PomodoroPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:converters="clr-namespace:KiteTodo.Converters"
      Title="专注计时">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisConverter"/>
    </Page.Resources>

    <Grid Margin="24,16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左侧：计时器区域 -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="400" Margin="0,0,16,0">

            <!-- Task Binding Selector -->
            <ui:Card Padding="12" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="绑定任务" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="TodoSelector" Grid.Column="0"
                                  ItemsSource="{Binding AvailableTodos}"
                                  DisplayMemberPath="Title"
                                  SelectionChanged="OnTodoSelected"
                                  IsEditable="False"
                                  Margin="0,0,8,0"/>
                        <ui:Button Grid.Column="1" Content="解绑" Appearance="Secondary"
                                   Click="OnUnbindTodo" Padding="8,4" x:Name="BtnUnbind"
                                   Visibility="Collapsed"/>
                    </Grid>
                    <TextBlock x:Name="BoundTaskLabel" FontSize="12" Opacity="0.6" Margin="0,4,0,0"
                               Visibility="Collapsed"/>
                </StackPanel>
            </ui:Card>

            <!-- Timer Display -->
            <Border x:Name="TimerRing" Width="260" Height="260" CornerRadius="130" Margin="0,0,0,24"
                    BorderThickness="6" BorderBrush="#DDDDDD">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding TimerDisplay}" FontSize="52" FontWeight="Light"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding StateLabel}" FontSize="14" Opacity="0.6"
                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    <TextBlock Text="{Binding BoundTodoTitle}" FontSize="12" Opacity="0.4"
                               HorizontalAlignment="Center" Margin="0,4,0,0"
                               TextTrimming="CharacterEllipsis" MaxWidth="200"
                               x:Name="TimerBoundTitle" Visibility="Collapsed"/>
                </StackPanel>
            </Border>

            <!-- Controls -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,24">
                <ui:Button Content="开始" Appearance="Primary" Margin="4"
                           Click="OnStart" MinWidth="90" x:Name="BtnStart"/>
                <ui:Button Content="暂停" Appearance="Secondary" Margin="4"
                           Click="OnPause" MinWidth="90" x:Name="BtnPause" Visibility="Collapsed"/>
                <ui:Button Content="继续" Appearance="Primary" Margin="4"
                           Click="OnResume" MinWidth="90" x:Name="BtnResume" Visibility="Collapsed"/>
                <ui:Button Content="取消" Appearance="Danger" Margin="4"
                           Click="OnCancel" MinWidth="90" x:Name="BtnCancel" Visibility="Collapsed"/>
            </StackPanel>

            <!-- Today Stats -->
            <ui:Card Padding="16">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <ui:SymbolIcon Symbol="Timer24" Margin="0,0,8,0"/>
                    <TextBlock Text="今日已完成 " FontSize="14"/>
                    <TextBlock Text="{Binding TodayPomodoros}" FontSize="14" FontWeight="Bold"/>
                    <TextBlock Text=" 个番茄钟" FontSize="14"/>
                </StackPanel>
            </ui:Card>
        </StackPanel>
        </ScrollViewer>

        <!-- 右侧：专注列表 -->
        <DockPanel Grid.Column="1" Margin="16,0,0,0">
            <!-- 日期导航栏 -->
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
                <ui:Button Appearance="Secondary" Padding="8,4" Click="OnPrevDay" ToolTip="前一天">
                    <ui:SymbolIcon Symbol="ChevronLeft24"/>
                </ui:Button>
                <TextBlock Text="{Binding RecordDateLabel}" FontSize="16" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="16,0" MinWidth="80"
                           TextAlignment="Center"/>
                <ui:Button Appearance="Secondary" Padding="8,4" Click="OnNextDay" ToolTip="后一天"
                           IsEnabled="{Binding CanGoNextDay}">
                    <ui:SymbolIcon Symbol="ChevronRight24"/>
                </ui:Button>
            </StackPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding TodayRecords}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ui:Card Padding="12" Margin="0,0,0,8">
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock Text="{Binding MoodEmoji}" FontSize="18"
                                                   DockPanel.Dock="Right" VerticalAlignment="Center"/>
                                        <StackPanel>
                                            <TextBlock FontSize="13" Opacity="0.7">
                                                <Run Text="{Binding Time}"/>
                                                <Run Text="  "/>
                                                <Run Text="{Binding Duration}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </DockPanel>
                                    <TextBlock Text="{Binding Note}" FontSize="13" Opacity="0.8"
                                               TextWrapping="Wrap" Margin="0,6,0,0"/>
                                    <!-- 操作按钮 -->
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0" HorizontalAlignment="Right">
                                        <!-- 未转待办时显示转换按钮 -->
                                        <ui:Button Appearance="Secondary" Padding="6,2" Margin="0,0,6,0"
                                                   Click="OnConvertToTodo" Tag="{Binding}"
                                                   ToolTip="转为今日待办"
                                                   Visibility="{Binding ConvertedToTodo, Converter={StaticResource BoolToVisConverter}, ConverterParameter=Invert}">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="TaskListAdd24" FontSize="14"/>
                                                <TextBlock Text="转待办" FontSize="11" Margin="4,0,0,0"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </ui:Button>
                                        <!-- 已转待办时显示状态标签 -->
                                        <TextBlock Text="✓ 已转待办" FontSize="11" Margin="0,0,6,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="#22A05A"
                                                   Visibility="{Binding ConvertedToTodo, Converter={StaticResource BoolToVisConverter}}"/>
                                        <ui:Button Appearance="Secondary" Padding="6,2"
                                                   Click="OnDeleteRecord" Tag="{Binding}"
                                                   ToolTip="删除记录">
                                            <ui:SymbolIcon Symbol="Delete24" FontSize="14"/>
                                        </ui:Button>
                                    </StackPanel>
                                </StackPanel>
                            </ui:Card>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</Page>
