<Page x:Class="KiteTodo.Views.Pages.MonthlyPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:converters="clr-namespace:KiteTodo.Converters"
      Title="月度总览"
      Language="zh-CN">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisConverter"/>
        <converters:CompletionRateToWidthConverter x:Key="RateToWidthConverter"/>
    </Page.Resources>

    <Grid Margin="20,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Month Navigation + Stats -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <ui:Button Icon="{ui:SymbolIcon ChevronLeft24}" Appearance="Secondary"
                           Click="OnPreviousMonth" Margin="0,0,8,0"/>
                <TextBlock Text="{Binding MonthLabel}" FontSize="22" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ui:Button Icon="{ui:SymbolIcon ChevronRight24}" Appearance="Secondary"
                           Click="OnNextMonth" Margin="0,0,16,0"/>
                <ui:Button Content="本月" Appearance="Primary" Click="OnGoToCurrentMonth"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock Text="本月待办: " Opacity="0.6" FontSize="13"/>
                <TextBlock Text="{Binding MonthCompletedTodos}" FontWeight="Bold" FontSize="13"/>
                <TextBlock Text="/" Opacity="0.6" FontSize="13"/>
                <TextBlock Text="{Binding MonthTotalTodos}" FontWeight="Bold" FontSize="13"/>
                <TextBlock Text=" 已完成" Opacity="0.6" FontSize="13"/>
            </StackPanel>
        </Grid>

        <!-- Week Day Headers -->
        <UniformGrid Grid.Row="1" Columns="7" Margin="0,0,0,6">
            <TextBlock Text="周日" HorizontalAlignment="Center" FontWeight="SemiBold" FontSize="12"
                       Foreground="{DynamicResource CustomFgSecondary}"/>
            <TextBlock Text="周一" HorizontalAlignment="Center" FontWeight="SemiBold" FontSize="12"
                       Foreground="{DynamicResource CustomFgSecondary}"/>
            <TextBlock Text="周二" HorizontalAlignment="Center" FontWeight="SemiBold" FontSize="12"
                       Foreground="{DynamicResource CustomFgSecondary}"/>
            <TextBlock Text="周三" HorizontalAlignment="Center" FontWeight="SemiBold" FontSize="12"
                       Foreground="{DynamicResource CustomFgSecondary}"/>
            <TextBlock Text="周四" HorizontalAlignment="Center" FontWeight="SemiBold" FontSize="12"
                       Foreground="{DynamicResource CustomFgSecondary}"/>
            <TextBlock Text="周五" HorizontalAlignment="Center" FontWeight="SemiBold" FontSize="12"
                       Foreground="{DynamicResource CustomFgSecondary}"/>
            <TextBlock Text="周六" HorizontalAlignment="Center" FontWeight="SemiBold" FontSize="12"
                       Foreground="{DynamicResource CustomFgSecondary}"/>
        </UniformGrid>

        <!-- Day Grid -->
        <ItemsControl Grid.Row="3" ItemsSource="{Binding DayCells}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="7"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Margin="2" Padding="5" CornerRadius="8" MinHeight="80"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource CustomSubtleBorder}"
                            Background="{DynamicResource CustomSubtleBg}"
                            Cursor="Hand" MouseLeftButtonUp="OnDayCellClick">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsToday}" Value="True">
                                        <Setter Property="Background" Value="#0078D4"/>
                                        <Setter Property="BorderBrush" Value="#005A9E"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsBlank}" Value="True">
                                        <Setter Property="Visibility" Value="Hidden"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Border.ToolTip>
                            <ToolTip Visibility="{Binding HasTodos, Converter={StaticResource BoolToVisConverter}}">
                                <TextBlock Text="{Binding TodoTitles}" FontSize="12"/>
                            </ToolTip>
                        </Border.ToolTip>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <!-- Day number + count -->
                            <DockPanel Grid.Row="0">
                                <TextBlock Text="{Binding Day}" FontSize="14" FontWeight="Bold" DockPanel.Dock="Left"
                                           Foreground="{DynamicResource CustomFg}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                    <Setter Property="Foreground" Value="White"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding Summary}" FontSize="10"
                                           Foreground="{DynamicResource CustomFgTertiary}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasTodos}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                    <Setter Property="Foreground" Value="White"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DockPanel>
                            <!-- Todo preview titles -->
                            <TextBlock Grid.Row="1" Text="{Binding TodoTitles}" FontSize="9"
                                       TextTrimming="CharacterEllipsis" TextWrapping="Wrap"
                                       MaxHeight="36" Margin="0,3,0,0"
                                       Foreground="{DynamicResource CustomFgTertiary}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasTodos}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                <Setter Property="Foreground" Value="#FFFFFFCC"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <!-- Progress bar -->
                            <Grid Grid.Row="2" Height="4" Margin="0,3,0,0">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasTodos}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Border Background="{DynamicResource CustomBorderBrush}" CornerRadius="2"/>
                                <Border CornerRadius="2" HorizontalAlignment="Left"
                                        Width="{Binding CompletionRate, Converter={StaticResource RateToWidthConverter}}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#0078D4"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                    <Setter Property="Background" Value="White"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Day Detail Overlay -->
        <Border Grid.RowSpan="4" Visibility="{Binding ShowDayDetail, Converter={StaticResource BoolToVisConverter}}"
                Background="#80000000" MouseLeftButtonUp="OnCloseDayDetail">
            <Border Background="{DynamicResource CustomOverlayBg}" CornerRadius="10" Padding="20"
                    MaxWidth="420" MinWidth="350"
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    BorderThickness="1" BorderBrush="{DynamicResource CustomBorderBrush}"
                    MouseLeftButtonUp="OnDayDetailInnerClick">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" Opacity="0.3" ShadowDepth="4"/>
                </Border.Effect>
                <StackPanel>
                    <DockPanel Margin="0,0,0,12">
                        <TextBlock FontSize="18" FontWeight="SemiBold"
                                   Text="{Binding SelectedDay.Date, StringFormat='{}{0:yyyy-MM-dd dddd}'}"/>
                        <TextBlock Text="{Binding SelectedDay.ProgressPercent}" FontSize="13" Opacity="0.6"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding SelectedDayTodos}" MaxHeight="400">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8,6" Margin="0,0,0,4" CornerRadius="6"
                                        BorderThickness="1"
                                        BorderBrush="{DynamicResource CustomSubtleBorder}"
                                        Background="{DynamicResource CustomSubtleBg}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="✓" Foreground="Green" FontWeight="Bold" Margin="0,0,8,0"
                                                   FontSize="13" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCompleted}" Value="False">
                                                            <Setter Property="Text" Value="○"/>
                                                            <Setter Property="Foreground"
                                                                    Value="{DynamicResource CustomFgTertiary}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontSize="13">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                                <Setter Property="Opacity" Value="0.5"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Description}" FontSize="11" Opacity="0.5"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="280">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Description}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="暂无待办" Opacity="0.4" HorizontalAlignment="Center" Margin="0,12"
                               FontSize="14">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedDayTodos.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ui:Button Content="关闭" Appearance="Secondary" HorizontalAlignment="Right"
                               Click="OnCloseDayDetailBtn" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Page>
