<Page x:Class="KiteTodo.Views.Pages.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:converters="clr-namespace:KiteTodo.Converters"
      Title="今日待办"
      Language="zh-CN">

    <Page.Resources>
        <converters:BoolToStrikethroughConverter x:Key="StrikethroughConverter"/>
        <converters:PriorityToColorConverter x:Key="PriorityColorConverter"/>
        <converters:BoolToOpacityConverter x:Key="BoolToOpacityConverter"/>
        <converters:NullToCollapsedConverter x:Key="NullToCollapsedConverter"/>
        <converters:ZeroToVisibleConverter x:Key="ZeroToVisibleConverter"/>
        <converters:ReminderTimeConverter x:Key="ReminderTimeConverter"/>
        <converters:PriorityToTextConverter x:Key="PriorityTextConverter"/>
        <converters:ProgressToTextConverter x:Key="ProgressTextConverter"/>
        <converters:EmptyStringToCollapsedConverter x:Key="EmptyStringToCollapsedConverter"/>
    </Page.Resources>

    <Grid Margin="24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Date Navigation -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Right">
                <TextBlock Text="{Binding ExportMessage}" FontSize="12" Foreground="Green"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ui:Button Content="导出周报" Appearance="Secondary"
                           Icon="{ui:SymbolIcon ClipboardPaste24}"
                           Click="OnExportWeeklyReport" Padding="8,4" FontSize="12"
                           ToolTip="生成本周周报并复制到剪贴板"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <ui:Button Icon="{ui:SymbolIcon ChevronLeft24}" Appearance="Secondary"
                           Click="OnPreviousDay" ToolTip="前一天" Margin="0,0,8,0"/>
                <TextBlock Text="{Binding SelectedDate, StringFormat='{}{0:yyyy-MM-dd dddd}'}"
                           FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ui:Button Icon="{ui:SymbolIcon ChevronRight24}" Appearance="Secondary"
                           Click="OnNextDay" ToolTip="后一天" Margin="0,0,16,0"/>
                <ui:Button Content="今天" Appearance="Primary" Click="OnGoToToday"/>
                <TextBlock VerticalAlignment="Center" Margin="24,0,0,0" Opacity="0.6"
                           Text="{Binding CompletedCount, StringFormat='已完成: {0}'}" FontSize="14"/>
                <TextBlock VerticalAlignment="Center" Margin="4,0,0,0" Opacity="0.6"
                           Text="{Binding TotalCount, StringFormat='/ {0}'}" FontSize="14"/>
            </StackPanel>
        </DockPanel>

        <!-- Week Bar -->
        <Border Grid.Row="1" Margin="0,0,0,8" Padding="2" CornerRadius="8"
                Background="{DynamicResource CustomSubtleBg}"
                BorderThickness="1" BorderBrush="{DynamicResource CustomSubtleBorder}">
            <DockPanel>
                <Button DockPanel.Dock="Left" Content="‹" Click="OnPreviousWeek"
                        Background="Transparent" BorderThickness="0"
                        FontSize="18" FontWeight="Bold"
                        Foreground="{DynamicResource CustomFgSecondary}"
                        Padding="8,0" Cursor="Hand" VerticalAlignment="Center"
                        ToolTip="上一周"/>
                <Button DockPanel.Dock="Right" Content="›" Click="OnNextWeek"
                        Background="Transparent" BorderThickness="0"
                        FontSize="18" FontWeight="Bold"
                        Foreground="{DynamicResource CustomFgSecondary}"
                        Padding="8,0" Cursor="Hand" VerticalAlignment="Center"
                        ToolTip="下一周"/>
                <ItemsControl ItemsSource="{Binding WeekDays}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Click="OnWeekDayClick" Cursor="Hand"
                                    Background="Transparent" BorderThickness="0"
                                    Padding="0" HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Stretch" Margin="2,0">
                                <Border x:Name="DayBorder" Padding="4,6" CornerRadius="6"
                                        Background="Transparent">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock x:Name="DayNameText" Text="{Binding DayName}"
                                                   FontSize="12" HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource CustomFgSecondary}"/>
                                        <TextBlock x:Name="DateText" Text="{Binding DateLabel}"
                                                   FontSize="11" HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource CustomFgTertiary}"/>
                                    </StackPanel>
                                </Border>
                            </Button>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter TargetName="DayBorder" Property="Background" Value="#0078D4"/>
                                    <Setter TargetName="DayNameText" Property="Foreground" Value="White"/>
                                    <Setter TargetName="DayNameText" Property="FontWeight" Value="SemiBold"/>
                                    <Setter TargetName="DateText" Property="Foreground" Value="White"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsToday}" Value="True">
                                    <Setter TargetName="DayNameText" Property="FontWeight" Value="Bold"/>
                                    <Setter TargetName="DateText" Property="FontWeight" Value="Bold"/>
                                </DataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsToday}" Value="True"/>
                                        <Condition Binding="{Binding IsSelected}" Value="False"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter TargetName="DayBorder" Property="Background" Value="{DynamicResource CustomTodayBg}"/>
                                    <Setter TargetName="DayNameText" Property="Foreground" Value="#0078D4"/>
                                    <Setter TargetName="DateText" Property="Foreground" Value="#0078D4"/>
                                </MultiDataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

        <!-- Tag Filter Bar -->
        <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                      Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal">
                <Button Content="全部" Click="OnClearTagFilter" Cursor="Hand"
                        Padding="10,4" Margin="0,0,4,0" FontSize="12"
                        x:Name="TagFilterAll">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#0078D4"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="12" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
                <ItemsControl ItemsSource="{Binding AvailableTags}" x:Name="TagFilterList">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding}" Click="OnTagFilterClick" Cursor="Hand"
                                    Padding="10,4" Margin="0,0,4,0" FontSize="12">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="{DynamicResource CustomSubtleBg}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource CustomFg}"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource CustomSubtleBorder}"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            CornerRadius="12" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Content="+" Click="OnAddCustomTag" Cursor="Hand"
                        Padding="10,4" Margin="0,0,4,0" FontSize="12" ToolTip="添加自定义标签">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="{DynamicResource CustomFgSecondary}"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource CustomSubtleBorder}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="12" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </ScrollViewer>

        <!-- Todo List -->
        <ListBox Grid.Row="3" ItemsSource="{Binding Todos}"
                 Background="Transparent" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 x:Name="TodoListBox">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0,2"/>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <ui:Card Padding="12,10" ContextMenuOpening="OnTodoContextMenuOpening"
                             MouseDoubleClick="OnTodoDoubleClick">
                        <ui:Card.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="移动到"/>
                                <MenuItem Header="开始专注" Click="OnStartFocus"/>
                            </ContextMenu>
                        </ui:Card.ContextMenu>
                        <ui:Card.ToolTip>
                            <ToolTip MaxWidth="380" Placement="Mouse">
                                <StackPanel Margin="4">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="15"
                                               TextWrapping="Wrap" Margin="0,0,0,6"/>
                                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap"
                                               FontSize="13" Opacity="0.8" Margin="0,0,0,6"
                                               Visibility="{Binding Description, Converter={StaticResource NullToCollapsedConverter}}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3"
                                                Visibility="{Binding ReminderTime, Converter={StaticResource NullToCollapsedConverter}}">
                                        <TextBlock Text="&#x23F0; 提醒: " FontSize="12" Opacity="0.6"/>
                                        <TextBlock Text="{Binding ReminderTime, Converter={StaticResource ReminderTimeConverter}}"
                                                   FontSize="12" Foreground="#0078D4"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                        <TextBlock Text="&#x1F4CB; 优先级: " FontSize="12" Opacity="0.6"/>
                                        <TextBlock Text="{Binding Priority, Converter={StaticResource PriorityTextConverter}}"
                                                   FontSize="12"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                        <TextBlock Text="&#x1F4CA; 进度: " FontSize="12" Opacity="0.6"/>
                                        <TextBlock Text="{Binding Progress, Converter={StaticResource ProgressTextConverter}}"
                                                   FontSize="12"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#x1F4C5; 计划日期: " FontSize="12" Opacity="0.6"/>
                                        <TextBlock Text="{Binding ScheduledDate, StringFormat='{}{0:yyyy-MM-dd}'}"
                                                   FontSize="12"/>
                                    </StackPanel>
                                </StackPanel>
                            </ToolTip>
                        </ui:Card.ToolTip>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="4"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Checkbox -->
                            <CheckBox Grid.Column="0" IsChecked="{Binding IsCompleted, Mode=OneWay}"
                                      VerticalAlignment="Center"
                                      Click="OnToggleComplete"/>

                            <!-- Priority Indicator -->
                            <Rectangle Grid.Column="1" Width="3" RadiusX="1.5" RadiusY="1.5"
                                       Fill="{Binding Priority, Converter={StaticResource PriorityColorConverter}}"
                                       VerticalAlignment="Stretch" Margin="4,2"/>

                            <!-- Title & Description & Progress & Reminder -->
                            <StackPanel Grid.Column="2" Margin="8,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Title}" FontSize="14"
                                               TextDecorations="{Binding IsCompleted, Converter={StaticResource StrikethroughConverter}}"
                                               Opacity="{Binding IsCompleted, Converter={StaticResource BoolToOpacityConverter}}"/>
                                    <Border CornerRadius="8" Padding="6,1" Margin="6,0,0,0"
                                            Background="#200078D4" VerticalAlignment="Center"
                                            Visibility="{Binding Category, Converter={StaticResource EmptyStringToCollapsedConverter}}">
                                        <TextBlock Text="{Binding Category}" FontSize="10" Foreground="#0078D4"/>
                                    </Border>
                                </StackPanel>
                                <Grid Margin="0,3,0,0"
                                      Opacity="{Binding IsCompleted, Converter={StaticResource BoolToOpacityConverter}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ProgressBar Grid.Column="0" Value="{Binding Progress}"
                                                 Minimum="0" Maximum="100" Height="4"
                                                 Foreground="#0078D4" Background="#20000000"/>
                                    <TextBlock Grid.Column="1" FontSize="12" Foreground="#333333"
                                               Margin="6,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"
                                               Text="{Binding Progress, Converter={StaticResource ProgressTextConverter}}"/>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <TextBlock Text="{Binding Description}" FontSize="12" Opacity="0.5"
                                               Visibility="{Binding Description, Converter={StaticResource NullToCollapsedConverter}}"
                                               TextTrimming="CharacterEllipsis" MaxWidth="300"/>
                                    <TextBlock FontSize="11" Opacity="0.5" Margin="8,0,0,0"
                                               Foreground="#0078D4"
                                               Text="{Binding ReminderTime, Converter={StaticResource ReminderTimeConverter}}"
                                               Visibility="{Binding ReminderTime, Converter={StaticResource NullToCollapsedConverter}}"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Edit Button -->
                            <ui:Button Grid.Column="3" Icon="{ui:SymbolIcon Edit24}"
                                       Appearance="Secondary" VerticalAlignment="Center"
                                       Click="OnEditTodo" ToolTip="编辑"
                                       Padding="6" Opacity="0.5" Margin="0,0,4,0"/>

                            <!-- Delete Button -->
                            <ui:Button Grid.Column="4" Icon="{ui:SymbolIcon Delete24}"
                                       Appearance="Secondary" VerticalAlignment="Center"
                                       Click="OnDeleteTodo" ToolTip="删除"
                                       Padding="6" Opacity="0.5"/>
                        </Grid>
                    </ui:Card>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Empty State -->
        <StackPanel Grid.Row="3" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="{Binding Todos.Count, Converter={StaticResource ZeroToVisibleConverter}}">
            <ui:SymbolIcon Symbol="ClipboardTaskListLtr24" FontSize="48" Opacity="0.3"/>
            <TextBlock Text="今日暂无待办事项" FontSize="16" Opacity="0.4"
                       HorizontalAlignment="Center" Margin="0,12,0,0"/>
        </StackPanel>

        <!-- Quick Add Bar -->
        <Grid Grid.Row="4" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ui:TextBox x:Name="QuickAddBox" Grid.Column="0"
                        PlaceholderText="添加新待办...（按回车添加）"
                        KeyDown="OnQuickAddKeyDown" Margin="0,0,8,0"/>
            <ui:Button Grid.Column="1" Content="添加" Appearance="Primary"
                       Icon="{ui:SymbolIcon Add24}" Click="OnAddTodo"/>
        </Grid>

        <!-- Edit Dialog Overlay -->
        <Border x:Name="EditOverlay" Grid.RowSpan="5" Visibility="Collapsed"
                Background="#80000000">
            <Border Background="{DynamicResource CustomOverlayBg}" CornerRadius="8" Padding="24" MaxWidth="480"
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    MinWidth="400">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" Opacity="0.3" ShadowDepth="4"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="编辑待办" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16"/>

                    <TextBlock Text="标题" FontSize="13" Margin="0,0,0,4"/>
                    <ui:TextBox x:Name="EditTitle" Margin="0,0,0,12"/>

                    <TextBlock Text="详细内容" FontSize="13" Margin="0,0,0,4"/>
                    <ui:TextBox x:Name="EditDescription" Margin="0,0,0,12"
                                MinHeight="80" AcceptsReturn="True" TextWrapping="Wrap"
                                PlaceholderText="输入详细描述（可选）"/>

                    <TextBlock Text="优先级" FontSize="13" Margin="0,0,0,4"/>
                    <ComboBox x:Name="EditPriority" Margin="0,0,0,12" Width="200" HorizontalAlignment="Left">
                        <ComboBoxItem Content="无" Tag="0"/>
                        <ComboBoxItem Content="低" Tag="1"/>
                        <ComboBoxItem Content="中" Tag="2"/>
                        <ComboBoxItem Content="高" Tag="3"/>
                    </ComboBox>

                    <TextBlock Text="标签" FontSize="13" Margin="0,0,0,4"/>
                    <ComboBox x:Name="EditCategory" Margin="0,0,0,12" Width="200" HorizontalAlignment="Left"
                              IsEditable="True"/>

                    <TextBlock Text="完成进度" FontSize="13" Margin="0,0,0,4"/>
                    <ComboBox x:Name="EditProgress" Margin="0,0,0,12" Width="200" HorizontalAlignment="Left">
                        <ComboBoxItem Content="0%"/>
                        <ComboBoxItem Content="10%"/>
                        <ComboBoxItem Content="20%"/>
                        <ComboBoxItem Content="30%"/>
                        <ComboBoxItem Content="40%"/>
                        <ComboBoxItem Content="50%"/>
                        <ComboBoxItem Content="60%"/>
                        <ComboBoxItem Content="70%"/>
                        <ComboBoxItem Content="80%"/>
                        <ComboBoxItem Content="90%"/>
                        <ComboBoxItem Content="100%"/>
                    </ComboBox>

                    <TextBlock Text="提醒时间" FontSize="13" Margin="0,0,0,4"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <DatePicker x:Name="EditReminderDate" Width="150" Margin="0,0,8,0"/>
                        <ComboBox x:Name="EditReminderHour" Width="70" Margin="0,0,4,0"/>
                        <TextBlock Text=":" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <ComboBox x:Name="EditReminderMinute" Width="70" Margin="0,0,8,0"/>
                        <ui:Button Content="清除" Appearance="Secondary" Click="OnClearReminder" Padding="8,4"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <ui:Button Content="取消" Appearance="Secondary" Click="OnCancelEdit" Margin="0,0,8,0"/>
                        <ui:Button Content="保存" Appearance="Primary" Click="OnSaveEdit"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Page>
