<Page x:Class="KiteTodo.Views.Pages.ExportPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="数据导出">

    <Grid Margin="24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="数据导出" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,16"/>

        <!-- Options -->
        <StackPanel Grid.Row="1" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="开始日期:" VerticalAlignment="Center" Width="70"/>
                <DatePicker SelectedDate="{Binding StartDate}" Width="200" Margin="0,0,16,0"/>
                <TextBlock Text="结束日期:" VerticalAlignment="Center" Width="70"/>
                <DatePicker SelectedDate="{Binding EndDate}" Width="200"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="格式:" VerticalAlignment="Center" Width="70"/>
                <RadioButton Content="Markdown" IsChecked="{Binding IsMarkdownFormat}" Margin="0,0,16,0"/>
                <RadioButton Content="纯文本" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <ui:Button Content="预览" Appearance="Secondary" Click="OnPreview" Margin="0,0,8,0"/>
                <ui:Button Content="导出文件" Appearance="Primary" Click="OnExport"
                           Icon="{ui:SymbolIcon ArrowDownload24}"/>
            </StackPanel>
        </StackPanel>

        <!-- Preview -->
        <ui:Card Grid.Row="2" Padding="12">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock Text="{Binding PreviewText}" TextWrapping="Wrap" FontFamily="Consolas"
                           FontSize="13"/>
            </ScrollViewer>
        </ui:Card>

        <!-- Backup & Restore -->
        <ui:Card Grid.Row="3" Padding="16" Margin="0,16,0,0">
            <StackPanel>
                <TextBlock Text="数据备份与恢复" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                <TextBlock Text="备份：将所有待办、笔记、番茄钟记录和设置导出到一个 JSON 文件。"
                           FontSize="12" Opacity="0.6" Margin="0,0,0,4"/>
                <TextBlock Text="恢复：从备份文件导入数据，将覆盖当前全部数据。"
                           FontSize="12" Opacity="0.6" Foreground="#E04040" Margin="0,0,0,12"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <ui:Button Content="备份数据" Appearance="Primary"
                               Icon="{ui:SymbolIcon ArrowDownload24}"
                               Click="OnBackup" Margin="0,0,12,0"/>
                    <ui:Button Content="恢复数据" Appearance="Secondary"
                               Icon="{ui:SymbolIcon ArrowUpload24}"
                               Click="OnRestore"/>
                </StackPanel>
                <TextBlock Text="{Binding BackupStatusMessage}" FontSize="12"
                           Foreground="#0078D4" TextWrapping="Wrap"/>

                <!-- 笔记本 Pro 备份 -->
                <Separator Margin="0,16,0,12"/>
                <TextBlock Text="笔记本 Pro (新笔记本)" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <TextBlock Text="新版笔记本使用 .md/.txt 文件存储，独立于 LiteDB。"
                           FontSize="12" Opacity="0.6" Margin="0,0,0,12"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <ui:Button Content="备份笔记文件" Appearance="Primary"
                               Click="OnBackupNotesPro" Margin="0,0,12,0"/>
                    <ui:Button Content="恢复笔记文件" Appearance="Secondary"
                               Click="OnRestoreNotesPro" Margin="0,0,12,0"/>
                    <ui:Button Content="迁移旧笔记→新笔记本" Appearance="Secondary"
                               Click="OnMigrateOldNotes" Margin="0,0,12,0"/>
                    <ui:Button Content="打开笔记目录" Appearance="Secondary"
                               Click="OnOpenNotesProFolder"/>
                </StackPanel>
                <TextBlock Text="{Binding NotesProStatusMessage}" FontSize="12"
                           Foreground="#0078D4" TextWrapping="Wrap"/>
            </StackPanel>
        </ui:Card>
    </Grid>
</Page>
