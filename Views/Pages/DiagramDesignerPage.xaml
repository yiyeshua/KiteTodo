<Page x:Class="KiteTodo.Views.Pages.DiagramDesignerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="clr-namespace:KiteTodo.Models"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="流程设计"
    Language="zh-CN"
    Focusable="True"
    PreviewKeyDown="OnPagePreviewKeyDown">

    <Page.Resources>
        <DrawingBrush x:Key="GridBrush" TileMode="Tile" Viewport="0,0,32,32" ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <GeometryDrawing Brush="White">
                    <GeometryDrawing.Pen>
                        <Pen Brush="#FFD8DDE6" Thickness="1"/>
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <LineGeometry StartPoint="0,0" EndPoint="32,0"/>
                            <LineGeometry StartPoint="0,0" EndPoint="0,32"/>
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingBrush.Drawing>
        </DrawingBrush>
    </Page.Resources>

    <Grid Margin="16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="流程设计" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource CustomFg}"/>
            <TextBlock Text="一个简单可用的流程图工具：新建、打开、保存、添加节点、连线、拖拽。"
                       FontSize="12" Opacity="0.65" Foreground="{DynamicResource CustomFgSecondary}"/>
        </StackPanel>

        <Border Grid.Row="1" Margin="0,0,0,10"
                CornerRadius="8"
                BorderThickness="1"
                BorderBrush="{DynamicResource CustomSubtleBorder}"
                Background="{DynamicResource CustomSubtleBg}">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal" Margin="10,8">
                    <ui:Button Content="新建" Appearance="Primary" Click="OnNewDocument" Margin="0,0,8,0"/>
                    <ui:Button Content="打开" Appearance="Secondary" Click="OnOpenDocument" Margin="0,0,8,0"/>
                    <ui:Button Content="保存" Appearance="Secondary" Click="OnSaveDocument" Margin="0,0,8,0"/>
                    <ui:Button Content="另存为" Appearance="Secondary" Click="OnSaveAsDocument" Margin="0,0,16,0"/>
                    <ui:Button Content="开始/结束" Tag="StartEnd" Appearance="Secondary" Click="OnPaletteItemClick" PreviewMouseLeftButtonDown="OnPaletteItemMouseLeftButtonDown" PreviewMouseMove="OnPaletteItemMouseMove" Margin="0,0,8,0"/>
                    <ui:Button Content="处理步骤" Tag="Process" Appearance="Secondary" Click="OnPaletteItemClick" PreviewMouseLeftButtonDown="OnPaletteItemMouseLeftButtonDown" PreviewMouseMove="OnPaletteItemMouseMove" Margin="0,0,8,0"/>
                    <ui:Button Content="判断" Tag="Decision" Appearance="Secondary" Click="OnPaletteItemClick" PreviewMouseLeftButtonDown="OnPaletteItemMouseLeftButtonDown" PreviewMouseMove="OnPaletteItemMouseMove" Margin="0,0,8,0"/>
                    <ui:Button Content="文本" Tag="Text" Appearance="Secondary" Click="OnPaletteItemClick" PreviewMouseLeftButtonDown="OnPaletteItemMouseLeftButtonDown" PreviewMouseMove="OnPaletteItemMouseMove" Margin="0,0,16,0"/>
                    <ui:Button Content="连接选中" Appearance="Secondary" Click="OnConnectSelected" Margin="0,0,8,0"/>
                    <ui:Button Content="删除选中" Appearance="Secondary" Click="OnDeleteSelected" Margin="0,0,16,0"/>
                    <ui:Button Content="全选" Appearance="Secondary" Click="OnSelectAll" Margin="0,0,16,0"/>
                    <ui:Button Content="-" Appearance="Secondary" Click="OnZoomOut" Width="36" Margin="0,0,6,0"/>
                    <Slider x:Name="ZoomSlider"
                            Width="140"
                            Minimum="0.5"
                            Maximum="2.0"
                            Value="1.0"
                            TickFrequency="0.1"
                            IsSnapToTickEnabled="False"
                            ValueChanged="OnZoomSliderValueChanged"
                            VerticalAlignment="Center"/>
                    <ui:Button Content="+" Appearance="Secondary" Click="OnZoomIn" Width="36" Margin="6,0,6,0"/>
                    <ui:Button Content="100%" Appearance="Secondary" Click="OnZoomReset" Margin="0,0,8,0"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    CornerRadius="8"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource CustomSubtleBorder}"
                    Background="{DynamicResource CustomCardBg}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Margin="10,10,10,6">
                        <TextBlock Text="已保存流程图" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource CustomFg}"/>
                        <TextBlock Text="双击可加载，支持数据库和文件两种保存方式。"
                                   FontSize="11"
                                   Opacity="0.65"
                                   Foreground="{DynamicResource CustomFgSecondary}"/>
                    </StackPanel>

                    <ListBox x:Name="SavedFlowchartsListBox"
                             Grid.Row="1"
                             Margin="6,0,6,6"
                             BorderThickness="0"
                             Background="Transparent"
                             MouseDoubleClick="OnSavedFlowchartsListBoxMouseDoubleClick">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:FlowchartStorageItem}">
                                <Border Margin="0,0,0,5"
                                        Padding="8,6"
                                        CornerRadius="7"
                                        BorderThickness="1"
                                        BorderBrush="{DynamicResource CustomSubtleBorder}"
                                        Background="{DynamicResource CustomSubtleBg}"
                                        PreviewMouseRightButtonDown="OnSavedFlowchartItemPreviewMouseRightButtonDown">
                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="重命名" Tag="{Binding}" Click="OnRenameSavedFlowchartClick"/>
                                            <MenuItem Header="删除记录" Tag="{Binding}" Click="OnDeleteSavedFlowchartClick"/>
                                            <MenuItem Header="打开文件所在位置" Tag="{Binding}" Click="OnOpenSavedFlowchartLocationClick"/>
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource CustomFg}"/>

                                        <TextBlock Grid.Row="1"
                                                   Margin="0,4,0,0"
                                                   Text="{Binding UpdatedAt, StringFormat=更新于 {0:MM-dd HH:mm}}"
                                                   FontSize="11"
                                                   Opacity="0.75"
                                                   Foreground="{DynamicResource CustomFgSecondary}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    CornerRadius="8"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource CustomSubtleBorder}"
                    Background="{DynamicResource CustomCardBg}">
                <ScrollViewer x:Name="DesignerScrollViewer"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              PreviewMouseWheel="OnDesignerMouseWheel">
                    <Grid x:Name="DesignerSurface" Width="2400" Height="1400">
                        <Grid.LayoutTransform>
                            <ScaleTransform x:Name="CanvasScaleTransform" ScaleX="1" ScaleY="1"/>
                        </Grid.LayoutTransform>

                        <Canvas x:Name="DesignerCanvas"
                                Width="2400"
                                Height="1400"
                                Background="{StaticResource GridBrush}"
                            PreviewMouseRightButtonDown="OnDesignerCanvasPreviewMouseRightButtonDown"
                                MouseLeftButtonDown="OnCanvasMouseLeftButtonDown"
                                MouseMove="OnCanvasMouseMove"
                                MouseLeftButtonUp="OnCanvasMouseLeftButtonUp"
                                AllowDrop="True"
                                DragOver="OnDesignerCanvasDragOver"
                                DragLeave="OnDesignerCanvasDragLeave"
                                Drop="OnDesignerCanvasDrop"/>

                          <Line x:Name="VerticalGuideLine"
                              Visibility="Collapsed"
                              X1="0" Y1="0" X2="0" Y2="1400"
                              Stroke="#FF2563EB"
                              StrokeThickness="1.5"
                              StrokeDashArray="4 4"
                              IsHitTestVisible="False"
                              Panel.ZIndex="900"/>

                          <Line x:Name="HorizontalGuideLine"
                              Visibility="Collapsed"
                              X1="0" Y1="0" X2="2400" Y2="0"
                              Stroke="#FF2563EB"
                              StrokeThickness="1.5"
                              StrokeDashArray="4 4"
                              IsHitTestVisible="False"
                              Panel.ZIndex="900"/>

                          <Canvas x:Name="OverlayCanvas"
                                  Width="2400"
                                  Height="1400"
                                  IsHitTestVisible="False"
                                  Panel.ZIndex="950">
                              <Rectangle x:Name="SelectionRectangle"
                                     Visibility="Collapsed"
                                     Stroke="#FF2563EB"
                                     StrokeThickness="1.5"
                                     StrokeDashArray="4 3"
                                     Fill="#332563EB"/>
                              <Border x:Name="PalettePreview"
                                      Width="160"
                                      Height="72"
                                      Visibility="Collapsed"
                                      Opacity="0.65"
                                      CornerRadius="10"
                                      Background="#99DBEAFE"
                                      BorderBrush="#FF2563EB"
                                      BorderThickness="1.5">
                                  <TextBlock x:Name="PalettePreviewText"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"
                                             FontSize="14"
                                             FontWeight="SemiBold"
                                             Foreground="#FF1E3A8A"/>
                              </Border>
                          </Canvas>

                    </Grid>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="3" Margin="0,10,0,0"
                CornerRadius="8"
                BorderThickness="1"
                BorderBrush="{DynamicResource CustomSubtleBorder}"
                Background="{DynamicResource CustomSubtleBg}">
            <DockPanel Margin="12,6">
                <TextBlock x:Name="DocumentNameText"
                           DockPanel.Dock="Left"
                           FontSize="12"
                           Foreground="{DynamicResource CustomFgSecondary}"/>
                <TextBlock x:Name="SelectionInfoText"
                           DockPanel.Dock="Right"
                           FontSize="12"
                           Foreground="{DynamicResource CustomFgSecondary}"/>
                <TextBlock x:Name="NodeCountText"
                           DockPanel.Dock="Right"
                           Margin="0,0,16,0"
                           FontSize="12"
                           Foreground="{DynamicResource CustomFgSecondary}"/>
            </DockPanel>
        </Border>
    </Grid>
</Page>
