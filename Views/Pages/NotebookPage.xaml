<Page x:Class="KiteTodo.Views.Pages.NotebookPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:controls="clr-namespace:KiteTodo.Controls"
      xmlns:converters="clr-namespace:KiteTodo.Converters"
      Title="记事本"
      Language="zh-CN">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:NullToCollapsedConverter x:Key="NullToCollapsedConverter"/>
        <converters:NullToVisibleConverter x:Key="NullToVisibleConverter"/>
    </Page.Resources>

    <Grid Margin="20,12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左侧：标题列表 -->
        <Border Grid.Column="0" CornerRadius="8" BorderThickness="1"
                BorderBrush="{DynamicResource CustomSubtleBorder}"
                Background="{DynamicResource CustomSubtleBg}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 标题 -->
                <TextBlock Grid.Row="0" Text="笔记列表" FontSize="15" FontWeight="SemiBold"
                           Padding="12,12,12,8" Foreground="{DynamicResource CustomFg}"/>

                <!-- 笔记列表 -->
                <ListBox Grid.Row="1" ItemsSource="{Binding VisibleNotes}"
                         SelectedItem="{Binding SelectedListItem}"
                         Background="Transparent" BorderThickness="0"
                         Padding="4,0,4,4">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="2"/>
                            <Setter Property="Margin" Value="0,0,0,1"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="8,4" CornerRadius="5"
                                    Margin="{Binding ItemMargin}"
                                    Tag="{Binding Note}"
                                    Background="{DynamicResource CustomCardBg}"
                                    BorderThickness="1"
                                    BorderBrush="{DynamicResource CustomSubtleBorder}">
                                <Border.ContextMenu>
                                    <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                                        <MenuItem Header="新建子笔记"
                                                  Icon="{ui:SymbolIcon AddCircle24}"
                                                  Click="OnCreateChildNote"/>
                                        <Separator/>
                                        <MenuItem Header="转化为待办"
                                                  Icon="{ui:SymbolIcon ClipboardTaskListLtr24}"
                                                  Click="OnConvertToTodo"/>
                                        <MenuItem Header="转入事项池"
                                                  Icon="{ui:SymbolIcon Archive24}"
                                                  Click="OnConvertToBacklog"/>
                                        <Separator/>
                                        <MenuItem Header="删除（保留子笔记）"
                                                  Icon="{ui:SymbolIcon DeleteDismiss24}"
                                                  Click="OnDeleteNoteKeepChildren"/>
                                        <MenuItem Header="删除（连同子笔记）"
                                                  Icon="{ui:SymbolIcon Delete24}"
                                                  Click="OnDeleteNoteWithChildren"/>
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Column="0"
                                            Width="18"
                                            Height="18"
                                            Margin="0,0,4,0"
                                            Padding="0"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Focusable="False"
                                            Tag="{Binding Note.Id}"
                                            Click="OnToggleChildNotes">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Setter Property="Opacity" Value="0"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasChildren}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding HasChildren}" Value="True"/>
                                                            <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Opacity" Value="1"/>
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <TextBlock Text="{Binding ExpandGlyph}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource CustomFgSecondary}"/>
                                    </Button>

                                    <Grid Grid.Column="1"
                                          Width="12"
                                          Margin="2,0,8,0"
                                          Visibility="{Binding ShowTreeGuide, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <Border Grid.Row="0"
                                                Width="1.5"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Stretch"
                                                Background="{DynamicResource CustomAccent}"
                                                Opacity="0.55"/>

                                        <Border Grid.Row="1"
                                                Width="1.5"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Stretch"
                                                Background="{DynamicResource CustomAccent}"
                                                Opacity="0.55"
                                                Visibility="{Binding ShowTreeGuideContinuation, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                        <Border Grid.Row="1"
                                                Height="1.5"
                                                Margin="6,0,0,0"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Top"
                                                Background="{DynamicResource CustomAccent}"
                                                Opacity="0.55"/>
                                    </Grid>

                                    <TextBlock Grid.Column="2"
                                               Text="{Binding DisplayTitle}"
                                               FontSize="12.5"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource CustomFg}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- 底部操作 -->
                <StackPanel Grid.Row="2" Margin="8,0,8,8">
                    <TextBlock Text="{Binding NoteSummary}"
                               Margin="0,0,0,8"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource CustomFgSecondary}"/>

                    <ui:Button Content="+ 新建顶级笔记" Appearance="Primary"
                               Command="{Binding CreateNoteCommand}"
                               HorizontalAlignment="Stretch"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- GridSplitter 分隔栏 -->
        <GridSplitter Grid.Column="1" Width="4" Background="Transparent"
                      ShowsPreview="True" ResizeBehavior="PreviousAndNext"
                      ResizeDirection="Columns" HorizontalAlignment="Center"/>

        <!-- 右侧：编辑区 -->
        <Border Grid.Column="2" CornerRadius="8" BorderThickness="1"
                BorderBrush="{DynamicResource CustomSubtleBorder}"
                Background="{DynamicResource CustomCardBg}"
                Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 标题与操作区 -->
                <Grid Grid.Row="0"
                      Visibility="{Binding SelectedNote, Converter={StaticResource NullToCollapsedConverter}}"
                      Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ui:TextBox x:Name="NoteTitleEditor"
                                Grid.Column="0"
                                Text="{Binding EditTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="笔记标题" FontSize="18" FontWeight="SemiBold"
                                Background="Transparent" BorderThickness="0"
                                Foreground="{DynamicResource CustomFg}"
                                Margin="0,0,12,0"
                                TextChanged="OnNoteTitleTextChanged"/>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:Button Content="A-" Appearance="Secondary" Padding="10,4" Margin="0,0,6,0" Click="OnDecreaseFontSize"/>
                        <ui:Button Content="A+" Appearance="Secondary" Padding="10,4" Margin="0,0,10,0" Click="OnIncreaseFontSize"/>
                        <CheckBox x:Name="AutoWrapToggle"
                                  Content="自动换行"
                                  IsChecked="True"
                                  VerticalAlignment="Center"
                                  Margin="0,0,10,0"
                                  Checked="OnAutoWrapChanged"
                                  Unchecked="OnAutoWrapChanged"/>
                        <TextBlock x:Name="SaveStatusTextBlock"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource CustomFgSecondary}"
                                   Text="已保存"/>
                        <ui:Button Icon="{ui:SymbolIcon Save24}"
                                   Content="保存"
                                   Appearance="Primary"
                                   Click="OnSaveNote"/>
                    </StackPanel>
                </Grid>

                <!-- 内容编辑 -->
                <Border Grid.Row="1"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource CustomSubtleBorder}"
                        Background="{DynamicResource CustomSubtleBg}"
                        Visibility="{Binding SelectedNote, Converter={StaticResource NullToCollapsedConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="52"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                BorderThickness="0,0,1,0"
                                BorderBrush="{DynamicResource CustomSubtleBorder}"
                                Background="#12000000">
                            <controls:LineNumberGutter x:Name="LineNumberGutter"
                                                       IsHitTestVisible="False"
                                                       Focusable="False"
                                                       Background="Transparent"
                                                       Foreground="{DynamicResource CustomFgSecondary}"
                                                       FontFamily="Consolas"
                                                       FontSize="13"
                                                       Padding="8,10,6,10"
                                                       LineCount="1"
                                                       LineHeight="20"
                                                       EditorPaddingTop="10"/>
                        </Border>

                        <controls:CurrentLineHighlightLayer x:Name="CurrentLineHighlight"
                                                            Grid.Column="1"
                                                            Background="#33FFD54F"
                                                            BorderBrush="#55E0B400"
                                                            BorderThickness="1"
                                                            IsHitTestVisible="False"
                                                            Focusable="False"
                                                            Panel.ZIndex="2"/>

                        <TextBox x:Name="NoteEditor"
                                 Grid.Column="1"
                                 AcceptsReturn="True"
                                 AcceptsTab="True"
                                 TextWrapping="Wrap"
                                 FontFamily="Consolas"
                                 FontSize="13"
                                 Padding="10"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Foreground="{DynamicResource CustomFg}"
                                 CaretBrush="{DynamicResource CustomFg}"
                                 HorizontalScrollBarVisibility="Auto"
                                 VerticalScrollBarVisibility="Auto"
                                 TextChanged="OnNoteEditorTextChanged"
                                 Loaded="OnNoteEditorLoaded"
                                 SizeChanged="OnNoteEditorSizeChanged"
                                 SelectionChanged="OnNoteEditorSelectionChanged"
                                 PreviewMouseWheel="OnNoteEditorPreviewMouseWheel"
                                 PreviewMouseLeftButtonUp="OnNoteEditorPointerChanged"
                                 PreviewMouseLeftButtonDown="OnNoteEditorPointerChanged"
                                 KeyUp="OnNoteEditorKeyUp"
                                 GotKeyboardFocus="OnNoteEditorGotKeyboardFocus"
                                 Panel.ZIndex="1"
                                 Opacity="1"/>
                    </Grid>
                </Border>

                <!-- 空状态 -->
                <StackPanel Grid.RowSpan="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding SelectedNote, Converter={StaticResource NullToVisibleConverter}}"
                            IsHitTestVisible="False">
                    <ui:SymbolIcon Symbol="Note24" FontSize="48" Opacity="0.2"/>
                    <TextBlock Text="选择或新建笔记" FontSize="14" Opacity="0.3"
                               HorizontalAlignment="Center" Margin="0,12,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
