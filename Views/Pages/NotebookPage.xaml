<Page x:Class="KiteTodo.Views.Pages.NotebookPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:converters="clr-namespace:KiteTodo.Converters"
      Title="记事本"
      Language="zh-CN">

    <Page.Resources>
        <converters:NullToCollapsedConverter x:Key="NullToCollapsedConverter"/>
        <converters:NullToVisibleConverter x:Key="NullToVisibleConverter"/>
    </Page.Resources>

    <Grid Margin="20,12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左侧：标题列表 -->
        <Border Grid.Column="0" CornerRadius="8" BorderThickness="1"
                BorderBrush="{DynamicResource CustomSubtleBorder}"
                Background="{DynamicResource CustomSubtleBg}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 标题 -->
                <TextBlock Grid.Row="0" Text="笔记列表" FontSize="15" FontWeight="SemiBold"
                           Padding="12,12,12,8" Foreground="{DynamicResource CustomFg}"/>

                <!-- 笔记列表 -->
                <ListBox Grid.Row="1" ItemsSource="{Binding Notes}"
                         SelectedItem="{Binding SelectedNote}"
                         Background="Transparent" BorderThickness="0"
                         Padding="4,0,4,4">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="4"/>
                            <Setter Property="Margin" Value="0,1"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="8,6" CornerRadius="5"
                                    Background="{DynamicResource CustomCardBg}"
                                    BorderThickness="1"
                                    BorderBrush="{DynamicResource CustomSubtleBorder}">
                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="转化为待办"
                                                  Icon="{ui:SymbolIcon ClipboardTaskListLtr24}"
                                                  Click="OnConvertToTodo"/>
                                        <Separator/>
                                        <MenuItem Header="删除"
                                                  Icon="{ui:SymbolIcon Delete24}"
                                                  Click="OnDeleteNote"/>
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="{Binding Title}"
                                               FontSize="13" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource CustomFg}"/>
                                    <TextBlock Grid.Row="1" Text="{Binding Content}"
                                               FontSize="11" Opacity="0.5"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource CustomFgSecondary}"
                                               Margin="0,2,0,0"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- 新建按钮 -->
                <ui:Button Grid.Row="2" Content="+ 新建笔记" Appearance="Primary"
                           Command="{Binding CreateNoteCommand}"
                           Margin="8,0,8,8" HorizontalAlignment="Stretch"/>
            </Grid>
        </Border>

        <!-- GridSplitter 分隔栏 -->
        <GridSplitter Grid.Column="1" Width="4" Background="Transparent"
                      ShowsPreview="True" ResizeBehavior="PreviousAndNext"
                      ResizeDirection="Columns" HorizontalAlignment="Center"/>

        <!-- 右侧：编辑区 -->
        <Border Grid.Column="2" CornerRadius="8" BorderThickness="1"
                BorderBrush="{DynamicResource CustomSubtleBorder}"
                Background="{DynamicResource CustomCardBg}"
                Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 编辑区工具栏（保存按钮） -->
                <DockPanel Grid.Row="0"
                           Visibility="{Binding SelectedNote, Converter={StaticResource NullToCollapsedConverter}}"
                           Margin="0,0,0,8">
                    <ui:Button DockPanel.Dock="Right"
                               Icon="{ui:SymbolIcon Save24}"
                               Content="保存"
                               Appearance="Primary"
                               Click="OnSaveNote"/>
                    <TextBlock Text="编辑笔记" FontSize="13" Opacity="0.5"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource CustomFgSecondary}"/>
                </DockPanel>

                <!-- 标题编辑 -->
                <ui:TextBox Grid.Row="1"
                            Text="{Binding EditTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="笔记标题" FontSize="18" FontWeight="SemiBold"
                            Background="Transparent" BorderThickness="0"
                            Foreground="{DynamicResource CustomFg}"
                            Visibility="{Binding SelectedNote, Converter={StaticResource NullToCollapsedConverter}}"
                            Margin="0,0,0,12"/>

                <!-- 内容编辑 -->
                <TextBox Grid.Row="2"
                         Text="{Binding EditContent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" TextWrapping="Wrap"
                         FontSize="13"
                         Background="Transparent" BorderThickness="0"
                         Foreground="{DynamicResource CustomFg}"
                         CaretBrush="{DynamicResource CustomFg}"
                         VerticalScrollBarVisibility="Auto"
                         Visibility="{Binding SelectedNote, Converter={StaticResource NullToCollapsedConverter}}"/>

                <!-- 空状态 -->
                <StackPanel Grid.RowSpan="3" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding SelectedNote, Converter={StaticResource NullToVisibleConverter}}"
                            IsHitTestVisible="False">
                    <ui:SymbolIcon Symbol="Note24" FontSize="48" Opacity="0.2"/>
                    <TextBlock Text="选择或新建笔记" FontSize="14" Opacity="0.3"
                               HorizontalAlignment="Center" Margin="0,12,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
