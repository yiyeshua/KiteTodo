<Page x:Class="KiteTodo.Views.Pages.ToolCollectionPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="工具集合"
      Language="zh-CN">

    <Page.Resources>
        <Style x:Key="ToolEntryButtonStyle" TargetType="ui:Button">
            <Setter Property="Width" Value="220"/>
            <Setter Property="Height" Value="116"/>
            <Setter Property="Margin" Value="0,0,18,18"/>
            <Setter Property="Padding" Value="18,16"/>
            <Setter Property="Appearance" Value="Secondary"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        </Style>
    </Page.Resources>

    <Grid Margin="24,18,10,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border x:Name="ToolHostHeader"
                Grid.Row="0"
                Margin="0,0,14,14"
                Padding="14,10"
                CornerRadius="12"
                BorderThickness="1"
                BorderBrush="{DynamicResource CustomSubtleBorder}"
                Background="{DynamicResource CustomCardBg}"
                Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <ui:Button x:Name="BackToWorkbenchButton"
                           Content="返回工作台"
                           Appearance="Secondary"
                           Click="OnBackToWorkbench"
                           Padding="12,6"/>

                <StackPanel Grid.Column="2">
                    <TextBlock x:Name="CurrentToolTitleText"
                               Text="工具"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource CustomFg}"/>
                    <TextBlock x:Name="CurrentToolSubtitleText"
                               Margin="0,4,0,0"
                               FontSize="12"
                               Opacity="0.68"
                               Foreground="{DynamicResource CustomFgSecondary}"/>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer x:Name="WorkbenchScrollViewer"
                      Grid.Row="1"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="ToolEntriesItemsControl">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ui:Button Tag="{Binding}"
                                   Click="OnToolEntryClick"
                                   Style="{StaticResource ToolEntryButtonStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="64"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Width="58"
                                        Height="58"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        CornerRadius="14"
                                        BorderThickness="0"
                                        Background="{Binding AccentBrush}">
                                    <TextBlock Text="{Binding Badge}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="24"
                                               FontWeight="SemiBold"
                                               Foreground="White"/>
                                </Border>

                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource CustomFg}"/>
                                    <TextBlock Text="{Binding Subtitle}"
                                               Margin="0,6,0,0"
                                               TextWrapping="Wrap"
                                               FontSize="12"
                                               Opacity="0.68"
                                               Foreground="{DynamicResource CustomFgSecondary}"/>
                                </StackPanel>
                            </Grid>
                        </ui:Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border x:Name="ToolHostBorder"
                Grid.Row="1"
                Margin="0,0,14,0"
                CornerRadius="14"
                BorderThickness="1"
                BorderBrush="{DynamicResource CustomSubtleBorder}"
                Background="{DynamicResource CustomCardBg}"
                Visibility="Collapsed">
            <ContentControl x:Name="ToolHostContent"/>
        </Border>
    </Grid>
</Page>