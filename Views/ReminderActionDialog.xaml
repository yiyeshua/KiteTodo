<Window x:Class="KiteTodo.Views.ReminderActionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="待办提醒"
        Width="460"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource CustomOverlayBg}">

    <Border Padding="22" CornerRadius="14" BorderThickness="1"
            BorderBrush="{DynamicResource CustomSubtleBorder}"
            Background="{DynamicResource CustomOverlayBg}">
        <StackPanel>
            <TextBlock Text="待办提醒" FontSize="19" FontWeight="SemiBold"
                       Foreground="{DynamicResource CustomFg}"/>

            <TextBlock x:Name="TodoTitleText"
                       Margin="0,14,0,0"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource CustomFg}"
                       TextWrapping="Wrap"/>

            <TextBlock x:Name="TodoDescriptionText"
                       Margin="0,8,0,0"
                       Foreground="{DynamicResource CustomFgSecondary}"
                       TextWrapping="Wrap"/>

            <Border Margin="0,16,0,0"
                    Padding="12,10"
                    Background="{DynamicResource CustomSubtleBg}"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource CustomSubtleBorder}"
                    CornerRadius="10">
                <StackPanel>
                    <TextBlock Text="快捷处理" FontWeight="SemiBold" Foreground="{DynamicResource CustomFg}"/>
                    <TextBlock Text="你可以直接完成任务，或者把提醒延后，不需要回到列表里再操作。"
                               Margin="0,6,0,0"
                               Foreground="{DynamicResource CustomFgSecondary}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <WrapPanel Margin="0,18,0,0" ItemWidth="120" ItemHeight="36">
                <Button Content="标记完成" Margin="0,0,8,8" Click="OnComplete" Background="#1F7A68" Foreground="White" BorderBrush="#1F7A68"/>
                <Button Content="延后 10 分钟" Margin="0,0,8,8" Click="OnSnooze10"/>
                <Button Content="延后 1 小时" Margin="0,0,8,8" Click="OnSnooze1Hour"/>
                <Button Content="改到明天" Margin="0,0,8,8" Click="OnMoveToTomorrow"/>
            </WrapPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Content="打开待办页" Padding="16,6" Margin="0,0,8,0" Click="OnOpenTodo"/>
                <Button Content="关闭" Padding="16,6" Click="OnClose" IsCancel="True"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>