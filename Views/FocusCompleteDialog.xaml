<Window x:Class="KiteTodo.Views.FocusCompleteDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="专注开始" Width="400" Height="300"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Grid Margin="24,20,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0" Text="� 这次要专注什么？" FontSize="15"
                   FontWeight="SemiBold" Margin="0,0,0,10"/>

        <!-- Note Input -->
        <TextBox Grid.Row="2" x:Name="NoteBox"
                 TextWrapping="Wrap" AcceptsReturn="True"
                 MaxLength="200" VerticalScrollBarVisibility="Auto"
                 Margin="0,0,0,14"/>

        <!-- Mood Label -->
        <TextBlock Grid.Row="3" Text="这次专注感觉如何？" FontSize="13" Margin="0,0,0,8"/>

        <!-- Mood Buttons -->
        <UniformGrid Grid.Row="4" Columns="4" Margin="0,0,0,16">
            <Button x:Name="BtnMood1" Tag="1" Click="OnMoodClick" Margin="3" Padding="6,8"
                    HorizontalContentAlignment="Center">
                <StackPanel>
                    <TextBlock Text="😊" FontSize="22" HorizontalAlignment="Center"/>
                    <TextBlock Text="高效" FontSize="11" HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button x:Name="BtnMood2" Tag="2" Click="OnMoodClick" Margin="3" Padding="6,8"
                    HorizontalContentAlignment="Center">
                <StackPanel>
                    <TextBlock Text="😰" FontSize="22" HorizontalAlignment="Center"/>
                    <TextBlock Text="焦虑" FontSize="11" HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button x:Name="BtnMood3" Tag="3" Click="OnMoodClick" Margin="3" Padding="6,8"
                    HorizontalContentAlignment="Center">
                <StackPanel>
                    <TextBlock Text="😴" FontSize="22" HorizontalAlignment="Center"/>
                    <TextBlock Text="疲惫" FontSize="11" HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button x:Name="BtnMood4" Tag="4" Click="OnMoodClick" Margin="3" Padding="6,8"
                    HorizontalContentAlignment="Center">
                <StackPanel>
                    <TextBlock Text="😌" FontSize="22" HorizontalAlignment="Center"/>
                    <TextBlock Text="轻松" FontSize="11" HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>
        </UniformGrid>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="保存" MinWidth="80" Margin="6,0" Padding="16,6"
                    Click="OnConfirm" IsDefault="True"/>
            <Button Content="跳过" MinWidth="80" Margin="6,0" Padding="16,6"
                    Click="OnSkip"/>
        </StackPanel>
    </Grid>
</Window>
