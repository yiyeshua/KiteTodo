<Window x:Class="KiteTodo.Views.BacklogTransferDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="转入事项池"
        Width="480"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False">

    <Grid>
        <Border CornerRadius="18"
                Background="{DynamicResource CustomContentBg}"
                BorderThickness="1"
                BorderBrush="{DynamicResource CustomSubtleBorder}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="26"
                                  ShadowDepth="10"
                                  Opacity="0.18"
                                  Color="#22000000"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        CornerRadius="18,18,0,0"
                        Background="{DynamicResource CustomCardBg}"
                        BorderThickness="0,0,0,1"
                        BorderBrush="{DynamicResource CustomSubtleBorder}"
                        Padding="22,18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Width="38"
                                Height="38"
                                CornerRadius="12"
                                Background="#E8F0FE"
                                VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Archive24"
                                           FontSize="18"
                                           Foreground="#1664D9"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" Margin="14,0,0,0">
                            <TextBlock Text="转入事项池"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource CustomFg}"/>
                            <TextBlock Text="选择是移动还是复制当前记事本"
                                       Margin="0,4,0,0"
                                       Foreground="{DynamicResource CustomFgSecondary}"/>
                        </StackPanel>

                        <Button Grid.Column="2"
                                Width="32"
                                Height="32"
                                Click="OnCancel"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                ToolTip="关闭">
                            <TextBlock Text="✕"
                                       FontSize="14"
                                       Foreground="{DynamicResource CustomFgSecondary}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Button>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="1" Margin="22,20,22,0">
                    <TextBlock Text="当前笔记"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource CustomFgTertiary}"/>
                    <Border Margin="0,8,0,0"
                            Padding="12,10"
                            CornerRadius="10"
                            Background="{DynamicResource CustomSubtleBg}"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource CustomSubtleBorder}">
                        <TextBlock x:Name="NoteTitleText"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource CustomFg}"
                                   TextWrapping="Wrap"/>
                    </Border>

                    <TextBlock Margin="0,14,0,0"
                               Foreground="{DynamicResource CustomFgSecondary}"
                               TextWrapping="Wrap">
                        <Run Text="移动：转入事项池后删除原记事本。"/>
                        <LineBreak/>
                        <Run Text="复制：转入事项池后保留原记事本。"/>
                    </TextBlock>

                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Padding="14"
                                CornerRadius="12"
                                Background="#F6FBF8"
                                BorderThickness="1"
                                BorderBrush="#CDE7DA">
                            <StackPanel>
                                <TextBlock Text="移动到事项池"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="#1F6D56"/>
                                <TextBlock Text="适合已经确认不再保留为记事本的内容。"
                                           Margin="0,6,0,0"
                                           Foreground="{DynamicResource CustomFgSecondary}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2"
                                Padding="14"
                                CornerRadius="12"
                                Background="#F8FAFD"
                                BorderThickness="1"
                                BorderBrush="#D7E2F2">
                            <StackPanel>
                                <TextBlock Text="复制到事项池"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="#315F9A"/>
                                <TextBlock Text="适合先归档到事项池，同时继续保留原笔记。"
                                           Margin="0,6,0,0"
                                           Foreground="{DynamicResource CustomFgSecondary}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>

                <Grid Grid.Row="2" Margin="22,22,22,22">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="1"
                            Content="取消"
                            MinWidth="84"
                            Margin="0,0,8,0"
                            Padding="18,7"
                            Click="OnCancel"
                            IsCancel="True"
                            Background="{DynamicResource CustomSubtleBg}"
                            BorderBrush="{DynamicResource CustomSubtleBorder}"
                            Foreground="{DynamicResource CustomFg}"/>

                    <Button Grid.Column="2"
                            Content="复制"
                            MinWidth="84"
                            Margin="0,0,8,0"
                            Padding="18,7"
                            Click="OnCopy"
                            Background="#EDF4FF"
                            BorderBrush="#C9DAF5"
                            Foreground="#315F9A"/>

                    <Button Grid.Column="3"
                            Content="移动"
                            MinWidth="92"
                            Padding="18,7"
                            Click="OnMove"
                            IsDefault="True"
                            Background="#1F7A68"
                            BorderBrush="#1F7A68"
                            Foreground="White"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>