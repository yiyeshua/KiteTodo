<Window x:Class="KiteTodo.Views.FloatingEntryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize">

    <StackPanel>
        <!-- 可拖动的浮标气泡（使用 Thumb 控件，原生支持拖拽） -->
        <Thumb x:Name="BubbleThumb"
               DragStarted="Thumb_DragStarted"
               DragDelta="Thumb_DragDelta"
               DragCompleted="Thumb_DragCompleted">
            <Thumb.Template>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="BubbleBorder" Width="56" Height="56"
                            CornerRadius="28"
                            Background="#0078D4"
                            Cursor="Hand">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="2"
                                              Opacity="0.3" Color="Black"/>
                        </Border.Effect>
                        <TextBlock x:Name="BubbleText" Text="K"
                                   FontSize="26" FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"/>
                    </Border>
                </ControlTemplate>
            </Thumb.Template>
            <Thumb.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="显示主窗口" Click="OnShowMainWindow"/>
                    <Separator/>
                    <MenuItem Header="隐藏浮标" Click="OnHideEntry"/>
                </ContextMenu>
            </Thumb.ContextMenu>
        </Thumb>
    </StackPanel>
</Window>
