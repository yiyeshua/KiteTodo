<UserControl x:Class="KiteTodo.Views.Tools.QrToolView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Language="zh-CN">

    <UserControl.Resources>
        <Style x:Key="PanelCardStyle" TargetType="Border">
            <Setter Property="Padding" Value="18,16"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CustomSubtleBorder}"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource CustomFg}"/>
        </Style>

        <Style x:Key="SectionHintStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource CustomFgSecondary}"/>
            <Setter Property="Opacity" Value="0.72"/>
        </Style>

        <Style x:Key="ImageStageStyle" TargetType="Border">
            <Setter Property="Margin" Value="0,14,0,0"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Height" Value="170"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#D9E3EE"/>
            <Setter Property="Background" Value="#F8FBFE"/>
            <Setter Property="ClipToBounds" Value="True"/>
        </Style>

        <Style x:Key="PathTextStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,10,0,0"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="18,16,18,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource PanelCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="124"/>
                        <RowDefinition Height="86"/>
                        <RowDefinition Height="230"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="二维码生成" Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Text="输入文本后实时生成，可选叠加中心 Logo。"
                                   Style="{StaticResource SectionHintStyle}"/>
                    </StackPanel>

                    <TextBox x:Name="GeneratorInputTextBox"
                             Grid.Row="1"
                             Margin="0,14,0,0"
                             Height="110"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             FontSize="14"
                             TextChanged="OnGeneratorInputTextChanged"/>

                    <WrapPanel Grid.Row="2" Margin="0,12,0,0">
                        <ui:Button Content="选择 Logo"
                                   Appearance="Secondary"
                                   Click="OnPickLogo"
                                   Margin="0,0,8,8"
                                   Padding="12,6"/>
                        <ui:Button Content="清除 Logo"
                                   Appearance="Secondary"
                                   Click="OnClearLogo"
                                   Margin="0,0,8,8"
                                   Padding="12,6"/>
                        <ui:Button Content="复制二维码"
                                   Appearance="Secondary"
                                   Click="OnCopyQrImage"
                                   Margin="0,0,8,8"
                                   Padding="12,6"/>
                        <ui:Button Content="保存 PNG"
                                   Appearance="Secondary"
                                   Click="OnSaveQrImage"
                                   Margin="0,0,8,8"
                                   Padding="12,6"/>
                        <ui:Button Content="清空内容"
                                   Appearance="Secondary"
                                   Click="OnClearGenerator"
                                   Margin="0,0,8,8"
                                   Padding="12,6"/>
                    </WrapPanel>

                    <Grid Grid.Row="3">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock x:Name="LogoPathTextBlock"
                                   Text="未选择 Logo"
                                   Style="{StaticResource PathTextStyle}"
                                   Margin="0,0,0,0"/>

                        <TextBlock Grid.Row="1"
                                   Text="生成结果"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Margin="0,12,0,0"
                                   Foreground="{DynamicResource CustomFg}"/>

                        <Border Grid.Row="2" Style="{StaticResource ImageStageStyle}" Height="150" Margin="0,8,0,0">
                            <Grid>
                                <Image x:Name="GeneratedQrImage" Stretch="Uniform"/>
                                <TextBlock x:Name="GeneratedQrPlaceholderText"
                                           Text="输入文本后自动生成二维码"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontSize="13"
                                           Foreground="#728197"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource PanelCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="124"/>
                        <RowDefinition Height="86"/>
                        <RowDefinition Height="230"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="二维码解析" Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Text="支持选择图片或拖拽图片到下方区域后自动解析。"
                                   Style="{StaticResource SectionHintStyle}"/>
                    </StackPanel>

                    <Border x:Name="ParseDropZoneBorder"
                            Grid.Row="1"
                            Margin="0,14,0,0"
                            Padding="14"
                            Height="110"
                            CornerRadius="12"
                            BorderThickness="1.2"
                            BorderBrush="#C9D6E5"
                            Background="#F8FBFE"
                            ClipToBounds="True"
                            AllowDrop="True"
                            DragEnter="OnParseImageDragEnter"
                            DragOver="OnParseImageDragOver"
                            DragLeave="OnParseImageDragLeave"
                            Drop="OnParseImageDrop">
                        <Grid>
                            <Image x:Name="ParsePreviewImage" Stretch="Uniform"/>
                            <TextBlock x:Name="ParsePreviewPlaceholderText"
                                       Text="拖拽二维码图片到这里，或使用下方按钮选择图片"
                                       Width="220"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="13"
                                       Foreground="#728197"/>
                        </Grid>
                    </Border>

                    <WrapPanel Grid.Row="2" Margin="0,12,0,0">
                        <ui:Button Content="选择图片"
                                   Appearance="Secondary"
                                   Click="OnPickParseImage"
                                   Margin="0,0,8,8"
                                   Padding="12,6"/>
                        <ui:Button Content="重新解析"
                                   Appearance="Secondary"
                                   Click="OnParseCurrentImage"
                                   Margin="0,0,8,8"
                                   Padding="12,6"/>
                        <ui:Button Content="复制结果"
                                   Appearance="Secondary"
                                   Click="OnCopyParsedText"
                                   Margin="0,0,8,8"
                                   Padding="12,6"/>
                        <ui:Button Content="清空解析"
                                   Appearance="Secondary"
                                   Click="OnClearParseArea"
                                   Margin="0,0,8,8"
                                   Padding="12,6"/>
                    </WrapPanel>

                    <Grid Grid.Row="3">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock x:Name="ParseImagePathTextBlock"
                                   Text="未选择图片"
                                   Style="{StaticResource PathTextStyle}"
                                   Margin="0,0,0,0"/>

                        <TextBlock Grid.Row="1"
                                   Text="解析结果"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Margin="0,12,0,0"
                                   Foreground="{DynamicResource CustomFg}"/>

                        <TextBox x:Name="ParsedResultTextBox"
                                 Grid.Row="2"
                                 Margin="0,8,0,0"
                                 Height="150"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 IsReadOnly="True"
                                 FontSize="13.5"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>