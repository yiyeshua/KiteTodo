<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <VlcWindowsX64Enabled>false</VlcWindowsX64Enabled>
    <VlcWindowsX86Enabled>false</VlcWindowsX86Enabled>
    <VideoLanLibVlcWindowsPackagePath>$(NuGetPackageRoot)videolan.libvlc.windows\3.0.21</VideoLanLibVlcWindowsPackagePath>

    <AssemblyTitle>KiteTodo</AssemblyTitle>
    <Description>A lightweight desktop todo application</Description>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <EmbeddedLibVlcArchive>$(MSBuildProjectDirectory)\obj\embedded\$(Configuration)\libvlc-win-x64.zip</EmbeddedLibVlcArchive>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AIStudio.Wpf.DiagramDesigner" Version="1.3.1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="H.NotifyIcon" Version="2.4.1" />
    <PackageReference Include="LibVLCSharp" Version="3.9.4" />
    <PackageReference Include="LiteDB" Version="5.0.21" />
    <PackageReference Include="Markdig" Version="0.41.3" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.21" />
    <PackageReference Include="WPF-UI" Version="3.0.5" />
    <PackageReference Include="ZXing.Net" Version="0.16.10" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="$(EmbeddedLibVlcArchive)" LogicalName="KiteTodo.libvlc-win-x64.zip" />
    <Content Include="$(VideoLanLibVlcWindowsPackagePath)\build\x64\libvlc.dll">
      <Link>libvlc\win-x64\libvlc.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <Content Include="$(VideoLanLibVlcWindowsPackagePath)\build\x64\libvlccore.dll">
      <Link>libvlc\win-x64\libvlccore.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <Content Include="$(VideoLanLibVlcWindowsPackagePath)\build\x64\plugins\**\*">
      <Link>libvlc\win-x64\plugins\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <Content Include="$(VideoLanLibVlcWindowsPackagePath)\build\x64\hrtfs\**\*">
      <Link>libvlc\win-x64\hrtfs\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <Content Include="$(VideoLanLibVlcWindowsPackagePath)\build\x64\lua\**\*">
      <Link>libvlc\win-x64\lua\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
  </ItemGroup>

  <!-- 笔记本 Pro：AINote 前端（开发时 Content，发布时嵌入 ZIP） -->
  <ItemGroup>
    <Content Include="Resources\NoteApp\**\*">
      <Link>NoteApp\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <PropertyGroup>
    <EmbeddedNoteAppArchive>$(MSBuildProjectDirectory)\obj\embedded\$(Configuration)\noteapp-win-x64.zip</EmbeddedNoteAppArchive>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="$(EmbeddedNoteAppArchive)" LogicalName="KiteTodo.noteapp-win-x64.zip" />
  </ItemGroup>

  <Target Name="CreateEmbeddedNoteAppArchive"
          BeforeTargets="CoreCompile">
    <MakeDir Directories="$([System.IO.Path]::GetDirectoryName('$(EmbeddedNoteAppArchive)'))" />
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -Command &quot;$src = '$(MSBuildProjectDirectory)\Resources\NoteApp\*'; $dst = '$(EmbeddedNoteAppArchive)'; if (Test-Path $dst) { Remove-Item $dst -Force }; Compress-Archive -Path $src -DestinationPath $dst -Force&quot;" />
  </Target>

  <Target Name="CreateEmbeddedLibVlcArchive"
          BeforeTargets="CoreCompile"
          Inputs="$(VideoLanLibVlcWindowsPackagePath)\build\x64\libvlc.dll;$(VideoLanLibVlcWindowsPackagePath)\build\x64\libvlccore.dll"
          Outputs="$(EmbeddedLibVlcArchive)">
    <MakeDir Directories="$([System.IO.Path]::GetDirectoryName('$(EmbeddedLibVlcArchive)'))" />
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -Command &quot;$src = '$(VideoLanLibVlcWindowsPackagePath)\build\x64'; $dst = '$(EmbeddedLibVlcArchive)'; if (Test-Path $dst) { Remove-Item $dst -Force }; Compress-Archive -Path (Join-Path $src '*') -DestinationPath $dst -Force&quot;" />
  </Target>

</Project>
