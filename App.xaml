<Application x:Class="KiteTodo.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             StartupUri="MainWindow.xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <!-- Custom theme-aware resources (updated in App.xaml.cs ApplyTheme) -->
            <SolidColorBrush x:Key="CustomWindowBg" Color="#F3F3F3"/>
            <SolidColorBrush x:Key="CustomCardBg" Color="#F0F4F8"/>
            <SolidColorBrush x:Key="CustomBorderBrush" Color="#D0D0D0"/>
            <SolidColorBrush x:Key="CustomSubtleBg" Color="#F5F5F5"/>
            <SolidColorBrush x:Key="CustomSubtleBorder" Color="#E0E0E0"/>
            <SolidColorBrush x:Key="CustomFg" Color="#222222"/>
            <SolidColorBrush x:Key="CustomFgSecondary" Color="#666666"/>
            <SolidColorBrush x:Key="CustomFgTertiary" Color="#999999"/>
            <SolidColorBrush x:Key="CustomTodayBg" Color="#E8F0FE"/>
            <SolidColorBrush x:Key="CustomOverlayBg" Color="White"/>
            <SolidColorBrush x:Key="CustomNavBg" Color="#F5F5F5"/>
            <SolidColorBrush x:Key="CustomContentBg" Color="#FAFAFA"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
